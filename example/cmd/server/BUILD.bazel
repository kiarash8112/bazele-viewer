load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "example.com/bazelviewer/example/cmd/server",
    visibility = ["//visibility:private"],
    deps = [
        "//example/internal/auth",
        "//example/internal/catalog",
        "//example/internal/db",
        "//example/internal/httpapi",
        "//example/internal/inventory",
        "//example/internal/metrics",
        "//example/internal/orders",
        "//example/internal/payments",
        "//example/internal/search",
        "//example/pkg/config",
        "//example/pkg/money",
        "//example/pkg/store",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)
