load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "shopctl_lib",
    srcs = ["main.go"],
    importpath = "example.com/bazelviewer/example/cmd/shopctl",
    visibility = ["//visibility:private"],
    deps = [
        "//example/internal/catalog",
        "//example/internal/db",
        "//example/internal/inventory",
