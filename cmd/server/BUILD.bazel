load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "example.com/bazelviewer/cmd/server",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/auth",
        "//internal/catalog",
        "//internal/db",
        "//internal/httpapi",
        "//internal/inventory",
        "//internal/metrics",
        "//internal/orders",
        "//internal/payments",
        "//internal/search",
        "//pkg/config",
        "//pkg/money",
        "//pkg/store",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)
